# 複製本檔為 .env 後即可 docker compose up（NFR-008：複製即可用）。
# 下列值僅為「本機 docker compose 專用」的明顯佔位值（Leader 裁決 D-01），
# 不是任何真實憑證。staging／prod 的實際值一律只存在於平台 secrets
# （GCP Secret Manager／GitHub repository secrets），永不進版控。
#
# Git Bash / PowerShell 皆可用同一種方式複製：
#   Git Bash:   cp .env.example .env
#   PowerShell: Copy-Item .env.example .env

# 執行環境：development（本機／dev）｜production（staging，由平台設定注入）
NODE_ENV=development

# 服務監聽埠。Cloud Run 會自動注入 PORT（預設 8080），應用程式一律讀此變數，
# 不得寫死埠號；本機 compose 同樣使用 8080。
PORT=8080

# PostgreSQL 連線字串。本機為 docker-compose.yml 內的 postgres:16-alpine，
# 帳密為僅限本機的明顯佔位值（dev/dev），非真實憑證。
# 下方三個 POSTGRES_* 只給 docker-compose.yml 的 db 服務用來初始化容器，
# 值必須與這條連線字串保持一致；staging 連 Neon，不會用到這三個變數。
DATABASE_URL=postgres://dev:dev@db:5432/todo
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=todo

# db 服務對外（宿主機）的埠。容器內部埠固定 5432，不受此值影響，
# DATABASE_URL 內的 "db:5432" 也不用改。本機多專案／多 git worktree
# 平行開發時若撞埠，改這個值即可（例如 5433），預設值為 5432（未設定時）。
# POSTGRES_HOST_PORT=5432

# HTTP Basic Auth 全站帳密（P0，Q-008）。本機佔位值僅供 docker compose 使用；
# staging 的實際帳密只存在於 GCP Secret Manager，倉庫中永不出現真實值。
BASIC_AUTH_USER=dev
BASIC_AUTH_PASSWORD=dev

# pino 日誌等級：debug｜info｜warn｜error。staging 預設 info。
LOG_LEVEL=info

# 允許的 CORS 來源（逗號分隔）。預設留空＝同源部署，不註冊 CORS 外掛
# （Leader 裁決 O-004、BR-015）。永遠不得填入 "*"。
CORS_ALLOWED_ORIGINS=
