{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true
  },
  "include": ["tests/**/*.ts"],
  // tests/e2e 走 tsconfig.e2e.json（需要 DOM 全域型別，理由見該檔檔頭）。
  "exclude": ["node_modules", "dist", "tests/e2e"]
}
