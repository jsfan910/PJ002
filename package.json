{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "E-001 待辦事項 Web 應用（Fastify + TypeScript，ESM）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:build": "tsc -w -p tsconfig.json",
    "dev:run": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\" \"tests/unit/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.ts\"",
    "test:integration:qa": "node --test --test-concurrency=1 \"tests/integration/qa/**/*.qa.test.ts\"",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:perf": "node tests/perf/tc085-tc086-nfr001.perf.mjs && node tests/perf/tc094-nfr007-capacity.perf.mjs",
    "migrate": "node dist/db/migrate.js",
    "verify:health": "node scripts/verify-health.ts"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.70.0"
  }
}
